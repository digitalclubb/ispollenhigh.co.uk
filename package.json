		"happy-dom": "^20.9.0",
		"svelte": "^5.55.7",
		"svelte-check": "^4.1.0",
		"typescript": "^6.0.0",
		"vite": "^8.0.0",
		"vitest": "^4.1.6"
	},
	"packageManager": "pnpm@10.30.3",
